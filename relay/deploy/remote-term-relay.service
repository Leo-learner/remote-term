# /etc/systemd/system/remote-term-relay.service  (same shape as mac-remote-relay.service)
[Unit]
Description=remote-term relay
After=network.target

[Service]
Type=simple
User=leo
Group=leo
WorkingDirectory=/opt/apps/remote-term-relay/relay
EnvironmentFile=/opt/apps/remote-term-relay/relay/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/apps/remote-term-relay/relay/data
# The box has under 1 GB of memory and several other apps; the relay needs about 50 MB.
MemoryMax=192M

[Install]
WantedBy=multi-user.target
