# Relay configuration (systemd reads it via EnvironmentFile; locally: node --env-file=.env server.js)
PORT=3040
HOST=127.0.0.1
PUBLIC_ORIGIN=https://term.dkz12345.com
RELAY_DATA_DIR=/opt/apps/remote-term-relay/relay/data
# Printed by `node agent/setup.js wss://term.dkz12345.com/agent` on the Mac
AGENT_TOKEN_SHA256=
